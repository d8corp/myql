{
  "name": "myql",
  "version": "1.0.1",
  "description": "CLI that builds and runs myql apps assembled from plugins",
  "homepage": "https://github.com/d8corp/myql",
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "private": true,
  "bin": {
    "myql": "bin/myql"
  },
  "scripts": {
    "build": "innetjs release -e -tc -lc",
    "release": "innetjs release -p -e -tc -lc",
    "test": "jest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "npm run build && cd release && npm link",
    "stop": "npm unlink myql -g",
    "restart": "npm run stop && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d8corp/myql.git"
  },
  "keywords": [
    "myql",
    "app",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/myql/issues"
  },
  "dependencies": {
    "@cantinc/logger": "^1.2.0",
    "@types/cross-spawn": "^6.0.6",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "rolldown": "^1.2.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "innetjs": "4.0.0-beta.15",
    "jest": "^29.2.2",
    "neostandard": "^0.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
